                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="【sync】-DxmPushFileSyncJob"
                class="com.br.marketing.sync.job.DxmPushFileSyncJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="推送度小满文件到客户SFTP"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="【sync】-FileUploadTaskMiNiOJob"
                class="com.br.marketing.sync.job.FileUploadTaskMiNiOJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="文件上传MiNio任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="【sync】-FileDownloadTaskMiNiOJob"
                class="com.br.marketing.sync.job.FileDownloadTaskMiNiOJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="文件下载MiNio任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

