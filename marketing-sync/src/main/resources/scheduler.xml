                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【sync】-TcCpaPushFileSyncVTJob"
                class="com.br.marketing.sync.job.TcCpaPushFileSyncVTJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="同程易融cpa自动化VT推送文件同步任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="【sync】-DxmPullFileSyncJob"
                class="com.br.marketing.sync.job.DxmPullFileSyncJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="拉取度小满文件"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
