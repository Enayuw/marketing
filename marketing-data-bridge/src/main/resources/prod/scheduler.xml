<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:reg="http://www.dangdang.com/schema/ddframe/reg"
       xmlns:job="http://www.dangdang.com/schema/ddframe/job"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                        http://www.springframework.org/schema/beans/spring-beans.xsd 
                        http://www.springframework.org/schema/context 
                        http://www.springframework.org/schema/context/spring-context.xsd 
                        http://www.dangdang.com/schema/ddframe/reg 
                        http://www.dangdang.com/schema/ddframe/reg/reg.xsd 
                        http://www.dangdang.com/schema/ddframe/job 
                        http://www.dangdang.com/schema/ddframe/job/job.xsd 
                        ">
    <context:component-scan base-package="com.br.marketing.bridge.job"/>

    <reg:zookeeper id="regCenter"
                   server-lists="${SERVER_LISTS}"
                   namespace="${NAMESPACE}"
                   base-sleep-time-milliseconds="${BASE_SLEEP_TIME_MILLISECONDS}"
                   max-sleep-time-milliseconds="${MAX_SLEEP_TIME_MILLISECONDS}"
                   max-retries="${MAX_RETRIES}"
                   nested-port="${NESTED_PORT}"
                   nested-data-dir="${NESTED_DATA_DIR}"/>


    <job:simple id="【bridge】-SftpToDbByCommonJob"
                class="com.br.marketing.bridge.job.SftpToDbByCommonJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="sftp文件数据入库"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-SftpToDbByResultDataJob"
                class="com.br.marketing.bridge.job.SftpToDbByResultDataJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="sftp运营结果文件数据入库"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-SftpToDbByDxIbuDataJob"
                class="com.br.marketing.bridge.job.SftpToDbByDxIbuDataJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="sftpDassIbu文件数据入库"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-SftpToDbByDxTransferDataJob"
                class="com.br.marketing.bridge.job.SftpToDbByDxTransferDataJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="sftpDass转化文件数据入库"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-ZhongBangPullFileDataJob"
                class="com.br.marketing.bridge.job.ZhongBangPullFileDataJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="众邦财富文件拉取,param格式：{'apiCode':'yyyyMMdd,yyyy-MM-dd HH:mm:ss,yyyy-MM-dd HH:mm:ss'}"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-TransferFileTaskJob"
                class="com.br.marketing.bridge.job.TransferFileTaskJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="转化数据作业"
                registry-center-ref="regCenter"
                sharding-total-count="9"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-ZhongYouDataPullJob"
                class="com.br.marketing.bridge.job.ZhongYouDataPullJob"
                cron="0 30 9 * * ?"
                description="中邮数据拉取"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【bridge】-JinMeiXinBlackListFileCheckJob"
                class="com.br.marketing.bridge.job.jinmeixin.JinMeiXinBlackListFileCheckJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="金美信黑名单文件检查任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
</beans>