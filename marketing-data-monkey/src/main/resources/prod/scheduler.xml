<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:reg="http://www.dangdang.com/schema/ddframe/reg"
       xmlns:job="http://www.dangdang.com/schema/ddframe/job"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                        http://www.springframework.org/schema/beans/spring-beans.xsd 
                        http://www.springframework.org/schema/context 
                        http://www.springframework.org/schema/context/spring-context.xsd 
                        http://www.dangdang.com/schema/ddframe/reg 
                        http://www.dangdang.com/schema/ddframe/reg/reg.xsd 
                        http://www.dangdang.com/schema/ddframe/job 
                        http://www.dangdang.com/schema/ddframe/job/job.xsd 
                        ">
    <context:component-scan base-package="com.br.marketing.monkey.job"/>

    <reg:zookeeper id="regCenter"
                   server-lists="${SERVER_LISTS}"
                   namespace="${NAMESPACE}"
                   base-sleep-time-milliseconds="${BASE_SLEEP_TIME_MILLISECONDS}"
                   max-sleep-time-milliseconds="${MAX_SLEEP_TIME_MILLISECONDS}"
                   max-retries="${MAX_RETRIES}"
                   nested-port="${NESTED_PORT}"
                   nested-data-dir="${NESTED_DATA_DIR}"/>

    <job:simple id="ZhongAnPushRosterLockingDataJob"
                class="com.br.marketing.monkey.job.ZhongAnPushRosterLockingDataJob"
                cron="0 0/10 18-23 * * ?"
                description="名单锁定推送众安"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A,1=B"
                monitor-execution="true"
                failover="true"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="ZhongAnPushBlackDataJob"
                class="com.br.marketing.monkey.job.ZhongAnPushBlackDataJob"
                cron="0 0/30 * * * ?"
                description="众安信贷自动化推送黑名单"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />


    <job:simple id="ZhongAnPushRosterLockingDataOtherTagJob"
                class="com.br.marketing.monkey.job.ZhongAnPushRosterLockingDataOtherTagJob"
                cron="0 0 21 * * ? 2050-3000"
                description="名单锁定其他标签推送众安"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A,1=B"
                monitor-execution="true"
                failover="true"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="DidiCallingRecordJob"
                class="com.br.marketing.monkey.job.didi.DidiCallingRecordJob"
                cron="0 0 21 * * ?"
                description="滴滴通话明细推送定时任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="DidiAllowJob"
                class="com.br.marketing.monkey.job.didi.DidiAllowJob"
                cron="0 0 0/1 * * ?"
                description="滴滴流量准入"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="DiDiModelingJob"
                class="com.br.marketing.monkey.job.didi.DiDiModelingJob"
                cron="0 0/30 * * * ?"
                description="滴滴建模定时任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />

    <job:simple id="DiDiNewModelingJob"
                class="com.br.marketing.monkey.job.didi.DiDiNewModelingJob"
                cron="0 0/30 * * * ?"
                description="滴滴建模新接口定时任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="DidiaInvalidityJob"
                class="com.br.marketing.monkey.job.didi.DidiaInvalidityJob"
                cron="0 0/10 21-23 * * ?"
                description="滴滴营销失败"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
</beans>