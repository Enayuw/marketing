<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.SYJOriginalDataMapper">

    <select id="queryOriginalData" resultType="com.br.marketing.entity.SYJOriginalData">
        select *
        from b_syj_original_data
        where local_id = #{localId}
        and query_status = 0
        and status = 1
        <if test="minId != null and minId >0">
            and id >=#{minId}
        </if>
        order by id asc
        limit #{pageSize}
    </select>

    <update id="batchUpdateStatus">
        update b_syj_original_data
        <trim prefix="set" suffixOverrides=",">
            <if test="queryStatus != null">
                query_status = #{queryStatus},
            </if>
            <if test="invocationStatus != null">
                invocation_status = #{invocationStatus},
            </if>
        </trim>
        where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </update>

</mapper>