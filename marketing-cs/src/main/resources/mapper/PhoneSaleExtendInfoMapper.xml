    <select id="getDxRecordByTransferType" parameterType="com.br.marketing.dto.PhoneSaleRecordInfoDTO" resultType="com.br.marketing.vo.PhoneSaleInfoVO">
        select id,cust_num as custNum,dx_type as dxType,`type`
        from b_phone_sale_extend_info
        where api_code = #{apiCode}
        and cust_num in
        <foreach collection="custNums" item="custNum" open="(" close=")" separator=",">
            #{custNum}
        </foreach>
        and p_status = 2
        and transform_type = #{transferType}
        <if test="startDate !=null and startDate !=''">
            <![CDATA[ and applet_date >= #{startDate} ]]>
        </if>
        <if test="endDate !=null and endDate !=''">
            <![CDATA[ and applet_date <= #{endDate} ]]>
        </if>
    </select>

    <select id="getDxRecordLastOne" parameterType="com.br.marketing.dto.PhoneSaleRecordInfoDTO" resultType="com.br.marketing.vo.PhoneSaleInfoVO">
        select b.cust_num as custNum,b.dx_type as dxType,b.`type`,b.applet_date from
        (
        select cust_num,max(applet_date) as applet_date
        from b_phone_sale_extend_info
        where api_code = #{apiCode}
          and cust_num in
        <foreach collection="custNums" item="custNum" open="(" separator="," close=")">
            #{custNum}
        </foreach>
        and p_status = 2
        and transform_type = #{transferType}
        group by cust_num
        ) as a
        left join b_phone_sale_extend_info b on a.cust_num = b.cust_num and a.applet_date = b.applet_date
        where b.api_code = #{apiCode} and b.p_status = 2 and b.transform_type = #{transferType}
    </select>

    <select id="getDxRecordLastTwo" parameterType="com.br.marketing.dto.PhoneSaleRecordInfoDTO" resultType="com.br.marketing.vo.PhoneSaleInfoVO">
        select b.cust_num as custNum,b.dx_type as dxType,b.`type`,b.applet_date from
        (
        select cust_num,max(applet_date) as applet_date
        from b_phone_sale_extend_info
        where api_code = #{apiCode} and p_status = 2
        and transform_type = #{transferType} and
        <foreach collection="custNumAndApplets" item="custNumAndApplet" open="(" separator="or" close=")">
            <![CDATA[ (cust_num = #{custNumAndApplet.custNum} and applet_date < #{custNumAndApplet.appletDate})]]>
        </foreach>
        group by cust_num
        ) as a
        left join b_phone_sale_extend_info b on a.cust_num = b.cust_num and a.applet_date = b.applet_date
        where b.api_code = #{apiCode} and b.p_status = 2 and b.transform_type = #{transferType}
    </select>
