<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DxmSftpConfigMapper">

    <select id="selectAllEnabled" resultType="com.br.marketing.entity.DxmSftpConfig">
        SELECT *
        FROM b_dxm_sftp_config
        WHERE status = 1
        <if test="apiCode !=null">
            and api_code = #{apiCode}
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>