<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DxmSftpConfigMapper">

    <select id="selectByApiCode" resultType="com.br.marketing.entity.DxmSftpConfig">
        SELECT *
        FROM b_dxm_sftp_config
        WHERE status = 1
        AND api_code = #{apiCode}
        AND type = #{type}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>