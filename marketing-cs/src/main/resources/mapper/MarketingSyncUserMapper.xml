<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.MarketingSyncUserMapper">
    <insert id="insertMarketingSyncUser" parameterType="com.br.marketing.entity.MarketingSyncUser" >
        <selectKey resultType="java.lang.Long" keyProperty="id" order="AFTER" >
            SELECT LAST_INSERT_ID()
        </selectKey>
        insert into b_marketing_sync_${apiCode}
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="apiCode != null" >
                api_code,
            </if>
            <if test="cusBatch != null" >
                cus_batch,
            </if>
            <if test="requestBatch != null" >
                request_batch,
            </if>
            <if test="custNum != null" >
                cust_num,
            </if>
            <if test="idCard != null" >
                id_card,
            </if>
            <if test="name != null" >
                name,
            </if>
            <if test="cell != null" >
                cell,
            </if>
            <if test="groupType != null" >
                group_type,
            </if>
            <if test="userType != null" >
                user_type,
            </if>
            <if test="registerDate != null" >
                register_date,
            </if>
            <if test="reserveField1 != null" >
                reserve_field1,
            </if>
            <if test="reserveField2 != null" >
                reserve_field2,
            </if>
            <if test="createTime != null" >
                create_time,
            </if>
            <if test="updateTime != null" >
                update_time,
            </if>
            <if test="appletDate != null" >
                applet_date,
            </if>
            <if test="status != null" >
                status,
            </if>
            <if test="failType != null" >
                fail_type,
            </if>
            <if test="appletTime != null" >
                applet_time,
            </if>
            <if test="isTask != null" >
                is_task,
            </if>
            <if test="taskTime != null" >
                task_time,
            </if>
            <if test="isRepeat != null" >
                is_repeat,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="apiCode != null" >
                #{apiCode,jdbcType=VARCHAR},
            </if>
            <if test="cusBatch != null" >
                #{cusBatch,jdbcType=VARCHAR},
            </if>
            <if test="requestBatch != null" >
                #{requestBatch,jdbcType=VARCHAR},
            </if>
            <if test="custNum != null" >
                #{custNum,jdbcType=VARCHAR},
            </if>
            <if test="idCard != null" >
                #{idCard,jdbcType=VARCHAR},
            </if>
            <if test="name != null" >
                #{name,jdbcType=VARCHAR},
            </if>
            <if test="cell != null" >
                #{cell,jdbcType=VARCHAR},
            </if>
            <if test="groupType != null" >
                #{groupType,jdbcType=VARCHAR},
            </if>
            <if test="userType != null" >
                #{userType,jdbcType=VARCHAR},
            </if>
            <if test="registerDate != null" >
                #{registerDate,jdbcType=VARCHAR},
            </if>
            <if test="reserveField1 != null" >
                #{reserveField1,jdbcType=VARCHAR},
            </if>
            <if test="reserveField2 != null" >
                #{reserveField2,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
            <if test="appletDate != null" >
                #{appletDate,jdbcType=VARCHAR},
            </if>
            <if test="status != null" >
                #{status,jdbcType=INTEGER},
            </if>
            <if test="failType != null" >
                #{failType,jdbcType=VARCHAR},
            </if>
            <if test="appletTime != null" >
                #{appletTime,jdbcType=TIMESTAMP},
            </if>
            <if test="isTask != null" >
                #{isTask,jdbcType=INTEGER},
            </if>
            <if test="taskTime != null" >
                #{taskTime,jdbcType=TIMESTAMP},
            </if>
            <if test="isRepeat != null" >
                #{isRepeat,jdbcType=INTEGER},
            </if>
        </trim>
    </insert>
    <select id="selectMarketingSyncUserById" resultType="com.br.marketing.entity.MarketingSyncUser">
        select *
        from b_marketing_sync_${apiCode}
        where id = #{id}
    </select>
    <select id="minId" resultType="java.lang.Long">
        select min(id) from b_marketing_sync_${apiCode}
        where applet_date = #{appletDate}
          <if test="dataType!=null">
              and is_task = #{dataType}
          </if>
        and user_type  in
        <foreach collection="userTypes" item="userType" open="(" separator="," close=")">
            #{userType}
        </foreach>
    </select>
    <select id="maxId" resultType="java.lang.Long">
        select max(id) from b_marketing_sync_${apiCode}
        where applet_date = #{appletDate}
        <if test="dataType!=null">
            and is_task = #{dataType}
        </if>
        and user_type  in
        <foreach collection="userTypes" item="userType" open="(" separator="," close=")">
            #{userType}
        </foreach>
    </select>
    <select id="getUserById" resultType="com.br.marketing.entity.MarketingSyncUser">
        select * from b_marketing_sync_${apiCode}
        where <![CDATA[  id >= #{minId} and id <= #{maxId} ]]>
          <if test="dataType != null">
              and is_task = #{dataType}
          </if>
    </select>
    <select id="selectSynsUserByCustNumLast" resultType="com.br.marketing.entity.MarketingSyncUser">
        select * from b_marketing_sync_${apiCode} where cust_num = #{custNum} order by applet_time desc limit 1;
    </select>
    <select id="getNewestByCustNum" resultType="com.br.marketing.entity.MarketingSyncUser">
        select * from b_marketing_sync_${apiCode} where cust_num = #{custNum} order by create_time desc limit 1;
    </select>
    <update id="updateSyncUserStatus">
        update b_marketing_sync_${apiCode} set is_task = #{isTask} where id = #{id}
    </update>

    <update id="updateSyncUserCaseEffective">
        update b_marketing_sync_${apiCode} set status = 2 , fail_type = CONCAT_WS(',',fail_type,'数据失效剔除') where status = 1 and cust_num  in
        <foreach collection="uIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="getSyncUserLastByCustNums" resultType="com.br.marketing.entity.MarketingSyncUser">
        select b.* from
        (
        select cust_num,max(applet_time) as applet_time
        from b_marketing_sync_${apiCode} a
        where cust_num in
        <foreach collection="custNums" item="custNum" open="(" separator="," close=")">
            #{custNum}
        </foreach>
        group by cust_num
        ) as a
        left join b_marketing_sync_${apiCode} b on a.cust_num = b.cust_num and a.applet_time = b.applet_time
    </select>
</mapper>
