<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.SyncConfigMapper">
	<select id="queryConfig" resultType="com.br.marketing.entity.SyncConfig" parameterType="java.lang.String">
		select * from b_sync_config where status=1 and type=#{type}
	</select>
	<select id="queryConfigByConditaion" resultType="com.br.marketing.entity.SyncConfig" parameterType="com.br.marketing.entity.SyncConfig">
		select * from b_sync_config where status=1 and api_code=#{apiCode} and type=#{type} and data_type=#{dataType}
	</select>
	<insert id="insertConfig" parameterType="com.br.marketing.entity.SyncConfig">
	   INSERT INTO `b_sync_config` (
			`api_code`,
			`type`,
			`src_path`,
			`target_path`,
			`suffix`,
			`check_finish`,
			`check_success`,
			`status`,
			`remark`,
			`src_type`,
			`src_sftp_host`,
			`src_sftp_port`,
			`src_sftp_user`,
			`src_sftp_pwd`,
			`target_type`,
			`target_sftp_host`,
			`target_sftp_port`,
			`target_sftp_user`,
			`target_sftp_pwd`,
			`create_time`
		)
		VALUES
			(
				#{apiCode},
				#{type},
				#{srcPath},
				#{targetPath},
				#{suffix},
				#{checkFinish},
				#{checkSuccess},
				#{status},
				#{remark},
				#{srcSftpHost},
				#{srcSftpPort},
				#{srcSftpUser},
				#{srcSftpPwd},
				#{targetSftpHost},
				#{targetSftpPort},
				#{targetSftpUser},
				#{targetSftpPwd},
				now()
			)
	</insert>

</mapper>
