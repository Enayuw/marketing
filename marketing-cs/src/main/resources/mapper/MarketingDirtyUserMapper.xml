<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.MarketingDirtyUserMapper">
	<insert id="insertDirtyUser" parameterType="java.util.List">
    	INSERT INTO b_marketing_dirty_user (
        	`api_code`,
        	`batch_number`,
        	`cus_num`,
        	`id_card`,
        	`name`,
        	`cell`,
        	`create_time`)
        VALUES
        <foreach collection="list" item="item" separator=",">
			(
			#{item.apiCode},
			#{item.batchNumber},
			#{item.cusNum},
			#{item.idCard},
			#{item.name},
			#{item.cell},
			now()
			)
		</foreach>
	</insert>
	<update id="updateUser" parameterType="java.util.List">
		update b_marketing_user set status=2 where id in (
		<foreach collection="list" index="index" item="item" open="" close="" separator=",">
			${item.id}
		</foreach>
		)
		and api_code=${item.apiCode}
	</update>


	<select id="queryUser" parameterType="com.br.marketing.entity.MarketingUser" resultType="com.br.marketing.entity.MarketingUser">
		SELECT
		*
		FROM
			b_marketing_user
		WHERE
			api_code = #{apiCode}
		<if test="batchNumber!= null">
			AND batch_number=#{batchNumber}
		</if>
		AND
			cus_num = #{cusNum}
		AND
			status=1
	</select>
	<select id="queryDirtyUser" parameterType="com.br.marketing.entity.MarketingUser" resultType="com.br.marketing.entity.MarketingUser">
		SELECT
		api_code,id_card,name,cell
		FROM
		b_marketing_dirty_user
		WHERE
		api_code = #{apiCode}
		and cell=#{cell}
	</select>

</mapper>
