<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.TagDataDetailMapper">
  <insert id="refreshbI_">
    ${refreshSql}
  </insert>

  <select id="queryPreviewTotalbI_" resultType="java.lang.Integer">
  <![CDATA[
    ${querySql}
    ]]>
</select>

  <select id="queryCells" resultType="java.lang.String">
    select cell
    from t_tag_data_detail
    where status = 1
      and calculate_date = #{date}
      and tag_code = #{tagCode}
      and cell in
      <foreach collection="cells" item="cell" separator="," open="(" close=")">
        #{cell}
      </foreach>
  </select>

</mapper>