<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.ZhonganMarketingBanMapper" >

    <select id="getByZKData" resultType="com.br.marketing.entity.ZhonganMarketingBan">
        select * from b_zhongan_marketing_ban where
        <![CDATA[  zk_date = #{date} ]]>
        order by create_time desc,id desc limit #{limitStart},2000;
    </select>
</mapper>