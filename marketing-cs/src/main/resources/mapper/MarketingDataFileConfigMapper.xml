<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.MarketingDataFileConfigMapper">

    <select id="getList" resultType="com.br.marketing.vo.dataclean.DataCleanConfigVO">

        SELECT
        id,api_code,clean_type as fileType,rule_name,field_config_show,create_time,update_time
        FROM
        b_marketing_data_file_config
        <where>
            <if test="fileType!= null">
                AND clean_type=#{fileType}
            </if>
            <if test="apiCode!= null">
                AND api_code=#{apiCode}
            </if>
        </where>
        and is_del = 1
        order by create_time desc
    </select>
</mapper>