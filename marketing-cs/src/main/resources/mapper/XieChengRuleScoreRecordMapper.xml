<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.XieChengRuleScoreRecordMapper">
    <update id="createXieChengScoreTidbTableByBatchNum" parameterType="java.lang.String">
        ${createTidbDDL}
    </update>

    <update id="createXieChengScoreDorisTableByBatchNumdoris_" parameterType="java.lang.String">
        ${createDorisDDL}
    </update>

    <insert id="insertXieChengScoreTidbTable">
        ${insertTidbSql}
    </insert>

    <select id="getXieChengScoreTidbTableCount" resultType="java.lang.Long">
        select count(1) from ${tableName}
    </select>


    <select id="getXieChengDataNumdoris_" resultType="java.lang.Integer">
        ${querySql}
    </select>

    <select id="getXieChengScoreTidbTableCount" resultType="java.lang.String">
        select count(1) from ${tableName}
    </select>

    <select id="selectRuleScoreDataExcludeTrueData" resultType="java.lang.String">
        ${queryRuleScoreDataSql}
        a left join b_xiecheng_colliding_data_loop_cycle b on a.cell = b.cell_sha256_code_list
        where b.id is null order by a.id limit 2000;
    </select>
</mapper>