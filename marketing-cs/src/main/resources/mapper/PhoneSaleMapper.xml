<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.PhoneSaleMapper">
    <sql id="Example_Where_Clause_Custom">
        <where>
            <foreach collection="oredCriteria" item="criteria" separator="or">
                <if test="criteria.valid">
                    <trim prefix="(" suffix=")" prefixOverrides="and">
                        <foreach collection="criteria.criteria" item="criterion">
                            <choose>
                                <when test="criterion.noValue">
                                    and ${criterion.condition}
                                </when>
                                <when test="criterion.singleValue">
                                    and ${criterion.condition} #{criterion.value}
                                </when>
                                <when test="criterion.betweenValue">
                                    and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
                                </when>
                                <when test="criterion.listValue">
                                    and ${criterion.condition}
                                    <foreach collection="criterion.value" item="listItem" open="(" close=")"
                                             separator=",">
                                        #{listItem}
                                    </foreach>
                                </when>
                            </choose>
                        </foreach>
                    </trim>
                </if>
            </foreach>
        </where>
    </sql>
    <select id="getPushDassData" resultType="com.br.marketing.client.dassservice.input.DassImportDataDTO">
        select
        *
        from b_phone_sale
        where local_id = #{localId}
        and status =1
        <if test="dataId != null and dataId>0">
            and id > #{dataId}
        </if>
        order by id asc limit 1000;
    </select>

    <select id="selectUidByExampletikv_" resultType="java.lang.String"
            parameterType="com.br.marketing.entity.PhoneSaleExample">
        select
        <if test="distinct">
            distinct
        </if>
        uid
        from b_phone_sale
        <if test="_parameter != null">
            <include refid="Example_Where_Clause_Custom"/>
        </if>
        <if test="orderByClause != null">
            order by ${orderByClause}
        </if>
    </select>

    <select id="getZhongYuanSaleByPage" resultType="com.br.marketing.entity.PhoneSale">
    select
      *
    from b_phone_sale
    where api_code = #{apiCode}
      and <![CDATA[ create_time >= #{startDate} and create_time <= #{endDate}]]>
      and user_type in
        <foreach collection="dxUserTypeList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
        limit ${(pageNum - 1) * pageSize}, #{pageSize}
    </select>

    <select id="getGroupByPhoneWithPaging" resultType="java.lang.String">
        select phone from b_phone_sale
        where local_id = #{localId}
          and status = 1
        group by phone
        order by phone
        limit #{offset}, #{pageSize}
    </select>

    <select id="getGroupByPhoneCount" resultType="java.lang.Integer">
        select count(distinct phone) from b_phone_sale
        where local_id = #{localId}
          and status = 1
    </select>

    <select id="getWeiZhongData" resultType="com.br.marketing.client.dassservice.input.DassImportDataDTO">
        select
        *
        from b_phone_sale
        where local_id = #{localId}
        and status =1 and phone = #{phone}
        <if test="dataId != null and dataId>0">
            and id > #{dataId}
        </if>
        order by id asc limit 1000;
    </select>

    <select id="getSpecialDataAll" resultType="com.br.marketing.client.dassservice.input.DassImportDataDTO">
        select
        *
        from b_phone_sale
        where local_id = #{localId}
        and status = 1 
        and phone = #{phone}
        order by create_time asc;
    </select>

    <!-- 动态分组：根据基础字段获取分组数量 -->
    <select id="getGroupByFieldCount" resultType="java.lang.Integer">
        SELECT COUNT(DISTINCT ${groupField})
        FROM b_phone_sale
        WHERE local_id = #{localId}
        AND status = 1
        AND ${groupField} IS NOT NULL
    </select>

    <!-- 动态分组：根据基础字段分页获取分组值 -->
    <select id="getGroupByFieldWithPaging" resultType="java.lang.String">
        SELECT ${groupField}
        FROM b_phone_sale
        WHERE local_id = #{localId}
        AND status = 1
        AND ${groupField} IS NOT NULL
        GROUP BY ${groupField}
        ORDER BY ${groupField}
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 动态分组：根据分组字段和分组值获取所有数据 -->
    <select id="getDataByGroupField" resultType="com.br.marketing.client.dassservice.input.DassImportDataDTO">
        SELECT *
        FROM b_phone_sale
        WHERE local_id = #{localId}
        AND status = 1
        AND ${groupField} = #{groupValue}
        ORDER BY create_time ASC
    </select>

    <!-- 获取文件的所有数据（用于extend字段分组） -->
    <select id="getAllDataByFileId" resultType="com.br.marketing.client.dassservice.input.DassImportDataDTO">
        SELECT *
        FROM b_phone_sale
        WHERE local_id = #{localId}
        AND status = 1
        ORDER BY create_time ASC
    </select>

</mapper>