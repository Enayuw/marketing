<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.tag.TagDataRuleMapper">
  <resultMap id="BaseResultMap" type="com.br.marketing.entity.tag.TagDataRule">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="tag_code" jdbcType="VARCHAR" property="tagCode" />
    <result column="tag_name" jdbcType="VARCHAR" property="tagName" />
    <result column="tag_number" jdbcType="INTEGER" property="tagNumber" />
    <result column="content" jdbcType="VARCHAR" property="content" />
    <result column="source_code" jdbcType="VARCHAR" property="sourceCode" />
    <result column="summary" jdbcType="VARCHAR" property="summary" />
    <result column="time_number" jdbcType="INTEGER" property="timeNumber" />
    <result column="time_unit" jdbcType="VARCHAR" property="timeUnit" />
    <result column="api_code_scope" jdbcType="VARCHAR" property="apiCodeScope" />
    <result column="api_code_license" jdbcType="VARCHAR" property="apiCodeLicense" />
    <result column="status" jdbcType="INTEGER" property="status" />
    <result column="opt_user_id" jdbcType="BIGINT" property="optUserId" />
    <result column="opt_user_name" jdbcType="VARCHAR" property="optUserName" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
    <result column="delete_flag" jdbcType="INTEGER" property="isRepeat" />
  </resultMap>
  <sql id="Example_Where_Clause">
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.valid">
          <trim prefix="(" prefixOverrides="and" suffix=")">
            <foreach collection="criteria.criteria" item="criterion">
              <choose>
                <when test="criterion.noValue">
                  and ${criterion.condition}
                </when>
                <when test="criterion.singleValue">
                  and ${criterion.condition} #{criterion.value}
                </when>
                <when test="criterion.betweenValue">
                  and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
                </when>
                <when test="criterion.listValue">
                  and ${criterion.condition}
                  <foreach close=")" collection="criterion.value" item="listItem" open="(" separator=",">
                    #{listItem}
                  </foreach>
                </when>
              </choose>
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </sql>

  <resultMap id="CreatorMap" type="com.br.marketing.dto.tag.TagCreatorDTO">
    <result column="opt_user_id" jdbcType="BIGINT" property="userId"/>
    <result column="opt_user_name" jdbcType="VARCHAR" property="userName"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, tag_code, tag_name, tag_number, content, source_code, summary, time_number, time_unit,
    api_code_scope, api_code_license, `status`, opt_user_id, opt_user_name, create_time,
    update_time
  </sql>
  <select id="selectList" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM t_tag_data_rule tdr
    <where> 1=1
      <if test="query.tagName != null and query.tagName != ''">
        AND tdr.tag_name LIKE CONCAT('%', #{query.tagName}, '%')
      </if>
      <if test="query.apiCodes != null and query.apiCodes.size() > 0">
        AND (
        <foreach collection="query.apiCodes" item="apiCode" separator=" OR ">
          FIND_IN_SET(#{apiCode}, tdr.api_code_license) > 0
        </foreach>
        )
      </if>
      <if test="query.creator != null">
        AND tdr.opt_user_id = #{query.creator}
      </if>
      AND tdr.delete_flag = 0
    </where>
    GROUP BY tdr.id
    ORDER BY create_time DESC
  </select>

  <select id="existsByTagName" resultType="boolean">
    SELECT COUNT(1) > 0
    FROM t_tag_data_rule
    WHERE tag_name = #{tagName}
      AND delete_flag = 0
  </select>

  <select id="selectByTagCode" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM t_tag_data_rule
    WHERE tag_code = #{tagCode}
    AND delete_flag = 0
  </select>

  <select id="selectByTagCodes" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM t_tag_data_rule
    WHERE tag_code IN
    <foreach collection="tagCodes" item="tagCode" open="(" separator="," close=")">
      #{tagCode}
    </foreach>
    AND delete_flag = 0
  </select>


  <select id="selectDistinctCreators" resultMap="CreatorMap">
    SELECT opt_user_id, opt_user_name
    FROM t_tag_data_rule
    WHERE 1 = 1 and delete_flag = 0
    GROUP BY opt_user_id, opt_user_name
    ORDER BY opt_user_id
  </select>


  <select id="selectDistinctTagNames" resultType="com.br.marketing.dto.tag.TagListResponseDTO">
    SELECT tag_name
    FROM t_tag_data_rule
    WHERE 1 = 1 and delete_flag = 0
    GROUP BY tag_name
  </select>

  <select id="queryByTagCodes" resultType="com.br.marketing.dto.tag.TagEffectiveDTO">
    SELECT
    tag_code as tagCode,
    tag_name as tagName
    FROM t_tag_data_rule
    WHERE status = 1
      and delete_flag = 0
      and tag_code IN
    <foreach collection="tagCodes" item="tagCode" open="(" separator="," close=")">
      #{tagCode}
    </foreach>
  </select>

  <update id="updateByTagCode" parameterType="com.br.marketing.entity.tag.TagDataRule">
    UPDATE t_tag_data_rule
    <set>
      <if test="tagName != null">tag_name = #{tagName},</if>
      <if test="tagNumber != null">tag_number = #{tagNumber},</if>
      <if test="content != null">content = #{content},</if>
      <if test="sourceCode != null">source_code = #{sourceCode},</if>
      <if test="summary != null">summary = #{summary},</if>
      <if test="timeNumber != null">time_number = #{timeNumber},</if>
      <if test="timeUnit != null">time_unit = #{timeUnit},</if>
      <if test="apiCodeScope != null">api_code_scope = #{apiCodeScope},</if>
      <if test="apiCodeLicense != null">api_code_license = #{apiCodeLicense},</if>
      <if test="status != null">status = #{status},</if>
      update_time = NOW()
    </set>
    WHERE tag_code = #{tagCode}
  </update>

  <update id="batchDelete" parameterType="com.br.marketing.entity.tag.TagDataRule">
    UPDATE t_tag_data_rule set delete_flag = 1
    WHERE tag_code IN
    <foreach collection="tagCodes" item="tagCode" open="(" separator="," close=")">
      #{tagCode}
    </foreach>
  </update>
</mapper>