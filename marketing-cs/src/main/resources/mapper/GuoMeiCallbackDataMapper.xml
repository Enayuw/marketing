<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.guomei.GuoMeiCallbackDataMapper">

    <sql id="example_where_2_clause">
        <where>
            <foreach collection="example.oredCriteria" item="criteria" separator="or">
                <if test="criteria.valid">
                    <trim prefix="(" suffix=")" prefixOverrides="and">
                        <foreach collection="criteria.criteria" item="criterion">
                            <choose>
                                <when test="criterion.noValue">
                                    and ${criterion.condition}
                                </when>
                                <when test="criterion.singleValue">
                                    and ${criterion.condition} #{criterion.value}
                                </when>
                                <when test="criterion.betweenValue">
                                    and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
                                </when>
                                <when test="criterion.listValue">
                                    and ${criterion.condition}
                                    <foreach collection="criterion.value" item="listItem" open="(" close=")"
                                             separator=",">
                                        #{listItem}
                                    </foreach>
                                </when>
                            </choose>
                        </foreach>
                    </trim>
                </if>
            </foreach>
        </where>
    </sql>
    <select id="getBatchPlanIdUserTypeByList" resultType="com.br.marketing.bo.GuoMeiTotalNumBO">
        select bgcd.batch, bgcd.plan_id, bgcd.user_type, count(*) as totalNum
        from b_guomei_callback_data bgcd
        where bgcd.api_code = '${apiCode}'
          and bgcd.local_id = ${localId}
          and bgcd.status = 1
          and bgcd.is_deleted = 0
        group by bgcd.batch, bgcd.plan_id, bgcd.user_type
    </select>


    <select id="selectByMaxIdAndExample" resultType="com.br.marketing.entity.guomei.GuoMeiCallbackData">
        select
        <if test="example.distinct">
            distinct
        </if>
        id,
        batch,
        plan_id,
        user_type,
        user_id,
        extend,
        create_date
        from b_guomei_callback_data
        <if test="_parameter != null">
            <include refid="example_where_2_clause"/>
        </if>
        <if test="maxId != null and maxId>0">
            and id>${maxId}
        </if>
        <choose>
            <when test="example.orderByClause != null">
                order by '${orderByClause}',id
            </when>
            <otherwise>
                order by id
            </otherwise>
        </choose>
        <if test="limit>0">
            limit ${limit}
        </if>
    </select>


</mapper>