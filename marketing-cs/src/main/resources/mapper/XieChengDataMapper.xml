<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.XieChengDataMapper" >

  <select id="selectByLocalId" resultType="com.br.marketing.entity.XieChengData">
    select
    *
    from b_xiecheng_data
    where local_id = #{localId}
    and status =1
    order by id asc limit 2000;
  </select>
</mapper>