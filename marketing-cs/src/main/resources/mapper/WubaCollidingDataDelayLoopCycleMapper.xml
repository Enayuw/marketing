<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.WubaCollidingDataDelayLoopCycleMapper">
    <select id="selectDuplicateData" resultType="java.lang.String">
        SELECT cell
        FROM b_wuba_colliding_data_delay_loop_cycle
        WHERE api_code = #{apiCode} AND is_deleted = 0
        AND cell in
        <foreach collection="cells" item="cell" open="(" separator="," close=")">
            #{cell}
        </foreach>
    </select>
</mapper>