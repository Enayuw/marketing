<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.RongshuCycleDataMapper">
    <select id="getCycleData" resultType="com.br.marketing.entity.RongshuCycleData">
        select * from b_rongshu_cycle_data
        <where>
            p_status = '1'
            <if test="minId != null and minId >0">
                AND id >=#{minId}
            </if>
            and push_daas_date in
            <foreach collection='pushDates' item='date' open='(' close=')' separator=','>
                #{date}
            </foreach>
            order by id asc limit 2000;
        </where>
    </select>
</mapper>