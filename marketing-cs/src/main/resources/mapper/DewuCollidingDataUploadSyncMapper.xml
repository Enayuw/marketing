<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DewuCollidingDataUploadSyncMapper" >
  <resultMap id="BaseResultMap" type="com.br.marketing.entity.DewuCollidingDataUploadSync" >
    <id column="id" property="id" jdbcType="BIGINT" />
    <result column="api_code" property="apiCode" jdbcType="VARCHAR" />
    <result column="local_id" property="localId" jdbcType="BIGINT" />
    <result column="mobile" property="mobile" jdbcType="VARCHAR" />
    <result column="user_id" property="userId" jdbcType="VARCHAR" />
    <result column="push_status" property="pushStatus" jdbcType="INTEGER" />
    <result column="push_time" property="pushTime" jdbcType="TIMESTAMP" />
    <result column="is_deleted" property="isDeleted" jdbcType="INTEGER" />
    <result column="data_message" property="dataMessage" jdbcType="VARCHAR" />
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>
  <resultMap id="ResultMapWithBLOBs" type="com.br.marketing.entity.DewuCollidingDataUploadSync" extends="BaseResultMap" >
    <result column="extend" property="extend" jdbcType="LONGVARCHAR" />
  </resultMap>

  <insert id="saveBatch" parameterType="list">
    insert into b_dewu_colliding_data_upload_sync (api_code, local_id,
    mobile,user_id,create_date, create_time,update_time)values
    <foreach collection="list" item="data" separator=",">
      (#{data.apiCode,jdbcType=VARCHAR}, #{data.localId,jdbcType=BIGINT},
      #{data.mobile,jdbcType=VARCHAR},  #{data.userId,jdbcType=VARCHAR},
       #{data.createDate,jdbcType=INTEGER},
      now(),now()
      )
    </foreach>
  </insert>
  <update id="updateBatchById">
    update b_dewu_colliding_data_upload_sync set push_status = #{pushStatus},push_time = now(),update_time= now() where id in
    <foreach collection="ids" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
    and is_deleted = 0
  </update>

  <select id="queryQuantityGroupByLocalId" parameterType="com.br.marketing.dto.dewu.DewuPushQueryQuantityDTO" resultType="Map">
    select
      count(*) as quantity,
      local_id as localId
    from
      b_dewu_colliding_data_upload_sync
    where
      push_status = #{pushStatus}
      and update_time >= #{startTime}
      and is_deleted = 0
    group by
      local_id
  </select>
</mapper>