<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.TcyrCpaPushDataMapper" >

    <select id="countByTaskId" resultType="java.lang.Integer">
        select count(1) from tcyr_cpa_push_data where task_id = #{taskId}
    </select>

    <select id="selectByTaskIdWithPagination" resultType="com.br.marketing.entity.TcyrCpaPushData">
        select * from tcyr_cpa_push_data where task_id = #{taskId} limit #{offset}, #{limit}
    </select>
</mapper>