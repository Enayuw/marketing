<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DiDiV5CollidingDataMapper">
    <resultMap id="BaseResultMap" type="com.br.marketing.entity.DiDiV5CollidingData" >
        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="api_code" property="apiCode" jdbcType="VARCHAR" />
        <result column="local_id" property="localId" jdbcType="BIGINT" />
        <result column="cell" property="cell" jdbcType="VARCHAR" />
        <result column="colliding_time" property="collidingTime" jdbcType="TIMESTAMP" />
        <result column="data_message" property="dataMessage" jdbcType="VARCHAR" />
        <result column="extend" property="extend" jdbcType="VARCHAR" />
        <result column="push_status" property="pushStatus" jdbcType="INTEGER" />
        <result column="status" property="status" jdbcType="INTEGER" />
        <result column="create_date" property="createDate" jdbcType="INTEGER" />
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>

    <select id="queryCollidingData" resultMap="BaseResultMap">
        SELECT api_code,local_id,cell,colliding_time
        FROM didi_v5_colliding_data
        WHERE push_status = 0
        AND status = 0
        AND colliding_time BETWEEN #{startTime} AND #{endTime}
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>
</mapper>