<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DiDiV5CollidingDataMapper">
    <resultMap id="BaseResultMap" type="com.br.marketing.entity.DiDiV5CollidingData">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="api_code" property="apiCode" jdbcType="VARCHAR"/>
        <result column="local_id" property="localId" jdbcType="BIGINT"/>
        <result column="cell" property="cell" jdbcType="VARCHAR"/>
        <result column="colliding_time" property="collidingTime" jdbcType="TIMESTAMP"/>
        <result column="data_message" property="dataMessage" jdbcType="VARCHAR"/>
        <result column="extend" property="extend" jdbcType="VARCHAR"/>
        <result column="push_status" property="pushStatus" jdbcType="INTEGER"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="create_date" property="createDate" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="queryCollidingData" resultMap="BaseResultMap">
        SELECT *
        FROM b_didi_v5_colliding_data
        WHERE push_status = 0
        AND status = 1
        AND colliding_time BETWEEN #{startTime} AND #{endTime}
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <update id="updatePushStatusByIds">
        update b_didi_v5_colliding_data
        set push_status = #{pushStatus,jdbcType=INTEGER}
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="queryCollidingFileIds" resultType="java.lang.Long">
        SELECT local_id
        FROM b_didi_v5_colliding_data
        WHERE push_status = 0
        AND status = 1
        AND colliding_time BETWEEN #{startTime} AND #{endTime}
        group by local_id
    </select>

    <select id="getPushStatusCountByLocalId" resultType="int">
        SELECT count(*)
        FROM b_didi_v5_colliding_data
        WHERE push_status = 0
          AND status = 1
          AND colliding_time BETWEEN #{startTime} AND #{endTime}
        group by local_id
    </select>
</mapper>