<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DataDistributeDetailLogMapper" >

    <select id="getToDataDistributeInfoList" resultType="java.lang.String">
        select
        cell
        from b_data_distribute_detail_log
        where api_code = #{apiCode}
        and cell in
        <foreach collection="cells" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
        and DATE_FORMAT(now(),"%Y-%m-%d") =  date_format(create_time,"%Y-%m-%d")
    </select>
</mapper>