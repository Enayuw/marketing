<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.MarketingTcyrCpaSuccessDataMapper" >
    <insert id="insertDataToDb">
        ${insertDbSql}
    </insert>

    <insert id="batchSave"  useGeneratedKeys="true" keyProperty="id">
        INSERT INTO b_tcyr_cpa_success_data (api_code,batch_no,sync_file_id,user_key,cell,is_match,start_date,end_date,create_time,update_time,status,status_msg,is_del,extend)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.apiCode}, #{item.batchNo}, #{item.syncFileId}, #{item.userKey},#{item.cell},#{item.isMatch},#{item.startDate},#{item.endDate},#{item.createTime},#{item.updateTime},#{item.status},#{item.statusMsg},#{item.isDel},#{item.extend})
        </foreach>
    </insert>
</mapper>