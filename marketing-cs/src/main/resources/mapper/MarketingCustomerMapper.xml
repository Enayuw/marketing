    <select id="selectByLike" resultType="com.br.marketing.entity.MarketingCustomer" parameterType="string">
        select id,cid,api_code,name,short_name
        from b_marketing_customer bmc
        where bmc.status = 1
        <if test="value !=null and value!=''">
            and bmc.short_name like concat("%", #{value},"%")
            or bmc.api_code like concat("%", #{value},"%")
        </if>
        order by bmc.id desc
    </select>

    <select id="getCustomerList" resultType="com.br.marketing.vo.MarketingCustomerListVO">
        select
        <include refid="Base_Column_List"/>
        from b_marketing_customer mc
        <where>
            status = 1
            <if test="cid != null and cid.trim() neq ''">
                and mc.cid like CONCAT('%',#{cid},'%')
            </if>
            <if test="apiCode != null and apiCode.trim() neq ''">
                and mc.api_code like CONCAT('%',#{apiCode},'%')
            </if>
        </where>
        order by mc.update_time desc, mc.create_time desc
    </select>

    <select id="getCidOrName" resultType="com.br.marketing.entity.MarketingCustomer">
        select id,cid,api_code,name,short_name
        from b_marketing_customer bmc
        <where>
            bmc.status = 1
            <if test="search !=null and search!=''">
                and (bmc.short_name like concat("%", #{search},"%")
                or bmc.cid like concat("%", #{search},"%"))
            </if>
        </where>
        order by bmc.id desc
    </select>

    <select id="selectByExampleAndShard" resultMap="BaseResultMap"
            parameterType="com.br.marketing.entity.MarketingCustomerExample">
        select
        <if test="example.distinct">
            distinct
        </if>
        <include refid="Base_Column_List"/>
        from b_marketing_customer
        <if test="_parameter != null">
            <include refid="Example_Where_Clause_Shard"/>
        </if>
        <if test="example.orderByClause != null">
            order by ${example.orderByClause}
        </if>
    </select>

    <sql id="Example_Where_Clause_Shard">
        <where>
            <foreach collection="example.oredCriteria" item="criteria" separator="or">
                <if test="criteria.valid">
                    <trim prefix="(" suffix=")" prefixOverrides="and">
                        <foreach collection="criteria.criteria" item="criterion">
                            <choose>
                                <when test="criterion.noValue">
                                    and ${criterion.condition}
                                </when>
                                <when test="criterion.singleValue">
                                    and ${criterion.condition} #{criterion.value}
                                </when>
                                <when test="criterion.betweenValue">
                                    and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
                                </when>
                                <when test="criterion.listValue">
                                    and ${criterion.condition}
                                    <foreach collection="criterion.value" item="listItem" open="(" close=")"
                                             separator=",">
                                        #{listItem}
                                    </foreach>
                                </when>
                            </choose>
                        </foreach>
                    </trim>
                </if>
            </foreach>
            <if test="shardingTotalCount != null and shardingTotalCount>0 and shardingItems != null">
                and mod(id, #{shardingTotalCount}) in
                <foreach collection='shardingItems' item='sharding' open='(' close=')' separator=','>
                    #{sharding}
                </foreach>
            </if>
        </where>
    </sql>

    <select id="selectCustomerBytestPartion" resultType="com.br.marketing.entity.MarketingCustomer">
        select *
        from (select *, rank() over (partition by api_code order by id desc) as num
              from b_marketing_customer
              where status = 1) as a
        where a.num = 1
    </select>

    <select id="selectCustomerBytestPartiontifh_" resultType="com.br.marketing.entity.MarketingCustomer">
        select *
        from (select *, rank() over (partition by api_code order by id desc) as num
              from b_marketing_customer
              where status = 1) as a
        where a.num = 1
    </select>

    <select id="selectCustomerBytestPartiontikv_" resultType="com.br.marketing.entity.MarketingCustomer">
        select *
        from (select *, rank() over (partition by api_code order by id desc) as num
              from b_marketing_customer
              where status = 1) as a
        where a.num = 1
    </select>

    <select id="getNameByApiCodeList" resultType="com.br.marketing.entity.MarketingCustomer">
        select name, short_name, cid, api_code
        from b_marketing_customer
        where api_code = '${apiCode}'
          and status = 1
    </select>

    <select id="getApiCodeByZs" resultType="java.lang.String">
        select api_code
        from b_marketing_customer
        where
        <foreach collection="apiCodePrefix" item="prefix" separator="or">
            api_code like concat(#{prefix},'%')
        </foreach>
    </select>

    <select id="checkTableExist" parameterType="string" resultType="Map">
        desc ${tableName}
    </select>

    <select id="getCidByApiCode" resultType="com.br.marketing.entity.MarketingCustomer">
        select name, short_name, cid, api_code
        from b_marketing_customer
        where api_code = #{apiCode}
        and status = 1
    </select>

</mapper>