<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.MarketingCustomerMapper">
    <select id="getCidOrApiCodeList" resultType="com.br.marketing.vo.CustomerSelectVO">
