<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.HaierReqMapper" >
    <select id="getDataWithStatus" resultType="com.br.marketing.entity.HaierReq">
        select *
        from b_haier_req
        where
        <if test="minId != null and minId>0">
            id>=#{minId} and
        </if>
        status in ('pending','init','handle')
        order by id asc limit 5000;
    </select>
</mapper>