<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.br.marketing.mapper.DewuCollidingDataLogMapper" >
  <resultMap id="BaseResultMap" type="com.br.marketing.entity.DewuCollidingDataLog" >
    <id column="id" property="id" jdbcType="BIGINT" />
    <result column="api_code" property="apiCode" jdbcType="VARCHAR" />
    <result column="local_id" property="localId" jdbcType="BIGINT" />
    <result column="mobile" property="mobile" jdbcType="VARCHAR" />
    <result column="return_status" property="returnStatus" jdbcType="INTEGER" />
    <result column="user_id" property="userId" jdbcType="VARCHAR" />
    <result column="is_deleted" property="isDeleted" jdbcType="INTEGER" />
    <result column="data_message" property="dataMessage" jdbcType="VARCHAR" />
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>
  <resultMap id="ResultMapWithBLOBs" type="com.br.marketing.entity.DewuCollidingDataLog" extends="BaseResultMap" >
    <result column="extend" property="extend" jdbcType="LONGVARCHAR" />
  </resultMap>
  <insert id="saveBatch" parameterType="list">
    insert into b_dewu_colliding_data_log (api_code, local_id,
    mobile,return_status,user_id, create_time,update_time)values
    <foreach collection="list" item="data" separator=",">
      (#{data.apiCode,jdbcType=VARCHAR}, #{data.localId,jdbcType=BIGINT},
      #{data.mobile,jdbcType=VARCHAR},  #{data.returnStatus,jdbcType=INTEGER},
      #{data.userId,jdbcType=VARCHAR},
    now(),now()
      )
    </foreach>
  </insert>


</mapper>