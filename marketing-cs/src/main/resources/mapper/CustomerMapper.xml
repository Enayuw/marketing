<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.br.marketing.mapper.CustomerMapper">
	<select id="getAllCustomer"  resultType="com.br.marketing.entity.Customer">
		SELECT
		*
		FROM
		b_marketing_customer order by sort desc;
	</select>
	<select id="getCustomerByApiCode" parameterType="java.lang.String"  resultType="com.br.marketing.entity.Customer">
		SELECT
		*
		FROM
		b_marketing_customer where api_code=#{apiCode}
	</select>

</mapper>
