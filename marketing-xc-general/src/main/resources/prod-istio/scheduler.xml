                class="com.br.marketing.xc.job.XieChengPreCollidingBlackListDeleteJob"
                cron="0 0/5 12-13 * * ? *"
                description="携程撞库前黑名单剔除"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】-NewXieChengSmsCollidingDataVtToSendJob"
                class="com.br.marketing.xc.job.NewXieChengSmsCollidingDataVtToSendJob"
                cron="0 0/10 6-8 * * ? *"
                description="携程短信撞库早 8 点定时任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
