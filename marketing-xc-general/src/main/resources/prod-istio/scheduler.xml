<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:reg="http://www.dangdang.com/schema/ddframe/reg"
       xmlns:job="http://www.dangdang.com/schema/ddframe/job"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                        http://www.springframework.org/schema/beans/spring-beans.xsd 
                        http://www.springframework.org/schema/context 
                        http://www.springframework.org/schema/context/spring-context.xsd 
                        http://www.dangdang.com/schema/ddframe/reg 
                        http://www.dangdang.com/schema/ddframe/reg/reg.xsd 
                        http://www.dangdang.com/schema/ddframe/job 
                        http://www.dangdang.com/schema/ddframe/job/job.xsd 
                        ">
    <context:component-scan base-package="com.br.marketing.xc.job"/>

    <reg:zookeeper id="regCenter"
                   server-lists="${SERVER_LISTS}"
                   namespace="${NAMESPACE}"
                   base-sleep-time-milliseconds="${BASE_SLEEP_TIME_MILLISECONDS}"
                   max-sleep-time-milliseconds="${MAX_SLEEP_TIME_MILLISECONDS}"
                   max-retries="${MAX_RETRIES}"
                   nested-port="${NESTED_PORT}"
                   nested-data-dir="${NESTED_DATA_DIR}"/>


    <job:simple id="【xc-general】XieChengTableBackupJob"
                class="com.br.marketing.xc.job.XieChengTableBackupJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="携程数据备份"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】XieChengRobDataCollidingJob"
                class="com.br.marketing.xc.job.XieChengRobDataCollidingJob"
                cron="0 0/1 16-23 * * ?"
                description="携程非周期数据撞库"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】XieChengCollidingDataProcessJob"
                class="com.br.marketing.xc.job.XieChengCollidingDataProcessJob"
                cron="0 00 10 * * ? *"
                description="携程撞库数据处理作业"
                registry-center-ref="regCenter"
                sharding-total-count="5"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】XieChengDynaRobDeleteDataJob"
                class="com.br.marketing.xc.job.XieChengDynaRobDeleteDataJob"
                cron="0 0/5 12-13 * * ? *"
                description="携程动态补充包数据剔除"
                registry-center-ref="regCenter"
                sharding-total-count="5"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】XieChengResetCollidingCountJob"
                class="com.br.marketing.xc.job.XieChengResetCollidingCountJob"
                cron="0 10 00 * * ? *"
                description="携程重置撞库次数"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】-XieChengFalseDynamicCollidingDataJob"
                class="com.br.marketing.xc.job.XieChengFalseDynamicCollidingDataJob"
                cron="0 05 00 * * ? *"
                description="携程动态包撞库数据补充作业"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】-XieChengCollidingHitRequestNoInitJob"
                class="com.br.marketing.xc.job.XieChengCollidingHitRequestNoInitJob"
                cron="0 0 18 29 9 ? 2050-2050"
                description="携程撞库一次性初始化撞库流水号作业"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
