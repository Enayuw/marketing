    />
    <job:simple id="【xc-general】XieChengCpsCollidingDataProcessJob"
                class="com.br.marketing.xc.job.XieChengCpsCollidingDataProcessJob"
                cron="0 */5 * * * ? *"
                description="携程CPS撞库数据同步任务"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="false"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
    <job:simple id="【xc-general】XieChengCpsRobDataCollidingJob"
                class="com.br.marketing.xc.job.XieChengCpsRobDataCollidingJob"
                cron="0 0/10 6-8 * * ? *"
                description="携程CPS非周期撞库作业"
                registry-center-ref="regCenter"
                sharding-total-count="1"
                sharding-item-parameters="0=A"
                monitor-execution="true"
                failover="false"
                misfire="false"
                disabled="true"
                overwrite="true"
                job-sharding-strategy-class="com.dangdang.ddframe.job.plugin.sharding.strategy.OdevitySortByNameJobShardingStrategy"
    />
</beans>