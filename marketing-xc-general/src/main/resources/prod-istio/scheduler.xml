    <job:simple id="【xc-general】XieChengRobDataCollidingManyTimesJob"
                class="com.br.marketing.xc.job.XieChengRobDataCollidingManyTimesJob"
                cron="0 0/1 * * * ?"
                description="携程非周期数据撞库"
